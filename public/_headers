# ==========================================
# Cloudflare Pages Headers Configuration
# Domain: cdn.ten.my.id
# ==========================================

# 1. Global Rules for All Assets (CORS, Security & Modern Delivery)
/*
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS
  Access-Control-Allow-Headers: Origin, X-Requested-With, Content-Type, Accept, Range
  Access-Control-Expose-Headers: Content-Length, Content-Range
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Timing-Allow-Origin: *

# 2. Portal HTML & Root (Short cache with background revalidation)
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# 3. Portal UI Internal Assets
/portal/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# 4. Public CDN Assets (1 week edge cache with 30-day stale fallback)
/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

# 5. Immutable Versioned Assets (1 year cache - high performance)
/v1/*
  Cache-Control: public, max-age=31536000, immutable
